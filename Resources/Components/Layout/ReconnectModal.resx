<?xml version="1.0" encoding="utf-8"?>
<root>
  <xsd:schema id="root" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xsd:element name="root" msdata:IsDataSet="true">
      <xsd:complexType>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element name="data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
                <xsd:element name="comment" type="xsd:string" minOccurs="0" msdata:Ordinal="2" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
            </xsd:complexType>
          </xsd:element>
        </xsd:choice>
      </xsd:complexType>
    </xsd:element>
  </xsd:schema>
  <data name="Rejoining" xml:space="preserve">
    <value>Rejoining the server...</value>
  </data>
  <data name="RejoinFailed" xml:space="preserve">
    <value>Rejoin failed... trying again in</value>
  </data>
  <data name="Seconds" xml:space="preserve">
    <value>seconds.</value>
  </data>
  <data name="FailedToRejoin" xml:space="preserve">
    <value>Failed to rejoin. Please retry or reload the page.</value>
  </data>
  <data name="Retry" xml:space="preserve">
    <value>Retry</value>
  </data>
  <data name="SessionPaused" xml:space="preserve">
    <value>The session has been paused by the server.</value>
  </data>
  <data name="FailedToResume" xml:space="preserve">
    <value>Failed to resume the session. Please retry or reload the page.</value>
  </data>
  <data name="Resume" xml:space="preserve">
    <value>Resume</value>
  </data>
</root>
