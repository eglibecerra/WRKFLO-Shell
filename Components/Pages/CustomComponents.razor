<div class="mb-6"></div>

@* ===== WORKFLOW STEPPER BRANCHING ===== *@
<MudPaper Class="pa-4 mb-4 mt-6" Elevation="1">
    <MudText Typo="Typo.h5" Class="mb-2">WorkflowStepsView</MudText>
    <MudText Typo="Typo.body2" Class="mb-3" Color="Color.Secondary">
        Hybrid stepper with carousel navigation, branch point indicators, and linear/full map toggle.
    </MudText>
    <MudText Typo="Typo.caption" Class="mb-3" Style="font-family: monospace;">
        &lt;WorkflowStepsView Steps="steps" VisibleSteps="5" /&gt;
    </MudText>
    <MudText Typo="Typo.subtitle2" Class="mb-2 mt-2">Parameters</MudText>
    <MudSimpleTable Dense="true" Bordered="true" Class="mb-4" Style="max-width: 700px;">
        <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
        <tbody>
            <tr><td><code>Steps</code></td><td>List&lt;BranchingStep&gt;</td><td>empty</td><td>List of workflow steps to display</td></tr>
            <tr><td><code>VisibleSteps</code></td><td>int</td><td>5</td><td>Max steps visible before carousel activates</td></tr>
        </tbody>
    </MudSimpleTable>

    <MudText Typo="Typo.subtitle2" Class="mb-2 mt-4">BranchingStep Model</MudText>
    <MudSimpleTable Dense="true" Bordered="true" Class="mb-4" Style="max-width: 700px;">
        <thead><tr><th>Property</th><th>Type</th><th>Description</th></tr></thead>
        <tbody>
            <tr><td><code>Name</code></td><td>string</td><td>Step display name (e.g. "Manager Approval")</td></tr>
            <tr><td><code>Role</code></td><td>string</td><td>Role or team responsible (e.g. "Direct Manager")</td></tr>
            <tr><td><code>Status</code></td><td>StepStatus</td><td>Completed, Active, Pending, or Skipped</td></tr>
            <tr><td><code>ActionedBy</code></td><td>string?</td><td>Who actioned this step (tooltip)</td></tr>
            <tr><td><code>ActionedDate</code></td><td>DateTime?</td><td>When the step was actioned (tooltip)</td></tr>
            <tr><td><code>Comment</code></td><td>string?</td><td>Comment left by the actioner</td></tr>
            <tr><td><code>SkipReason</code></td><td>string?</td><td>Reason this step was skipped</td></tr>
            <tr><td><code>BranchConditionLabel</code></td><td>string?</td><td>Label for the branch condition (e.g. "Amount threshold")</td></tr>
            <tr><td><code>Branches</code></td><td>List&lt;BranchPath&gt;?</td><td>Possible paths from this step (null = no branching)</td></tr>
        </tbody>
    </MudSimpleTable>

    <MudText Typo="Typo.subtitle2" Class="mb-2 mt-4">BranchPath Model</MudText>
    <MudSimpleTable Dense="true" Bordered="true" Class="mb-4" Style="max-width: 700px;">
        <thead><tr><th>Property</th><th>Type</th><th>Description</th></tr></thead>
        <tbody>
            <tr><td><code>Condition</code></td><td>string</td><td>Condition that triggers this path (e.g. "Amount &gt; $5,000")</td></tr>
            <tr><td><code>TargetStepName</code></td><td>string</td><td>Name of the step this path leads to</td></tr>
            <tr><td><code>WasTaken</code></td><td>bool</td><td>Whether this path was actually taken</td></tr>
        </tbody>
    </MudSimpleTable>

    <MudText Typo="Typo.h6" Class="mb-2 mt-4">Long Workflow — Carousel Active (8 steps)</MudText>
    <WorkflowStepsView Steps="_longWorkflowSteps" VisibleSteps="5" />

    <MudText Typo="Typo.h6" Class="mb-2 mt-6">Short Workflow — No Scrolling Needed (5 steps)</MudText>
    <WorkflowStepsView Steps="_branchingExpenseSteps" VisibleSteps="5" />

    <MudText Typo="Typo.h6" Class="mb-2 mt-6">IT Access Request — Completed with Skipped Branch</MudText>
    <WorkflowStepsView Steps="_branchingITSteps" VisibleSteps="5" />
</MudPaper>

<MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-4">More custom components coming soon...</MudText>

