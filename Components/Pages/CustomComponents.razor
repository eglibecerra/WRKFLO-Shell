@page "/custom-components"

<PageTitle>Custom Components</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Custom Components</MudText>

@* ===== STATUS TABS ===== *@
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h5" Class="mb-2">StatusTabs</MudText>
    <MudText Typo="Typo.body2" Class="mb-3" Color="Color.Secondary">
        Segmented button bar for filtering forms by status. Reusable component.
    </MudText>
    <MudText Typo="Typo.caption" Class="mb-3" Style="font-family: monospace;">
        &lt;StatusTabs InboxCount="36" OutboxCount="714" CompleteCount="15555" ActiveTab="inbox" OnTabChanged="Handler" /&gt;
    </MudText>
    <StatusTabs InboxCount="36" OutboxCount="714" CompleteCount="15555" ActiveTab="inbox" OnTabChanged="OnDemoTabChanged" />
    <MudText Typo="Typo.body2" Class="mt-3">Selected tab: <strong>@_demoTab</strong></MudText>
</MudPaper>

@* ===== LOADING BAR ===== *@
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h5" Class="mb-2">LoadingBar</MudText>
    <MudText Typo="Typo.body2" Class="mb-3" Color="Color.Secondary">
        Animated indeterminate progress bar for loading states. Toggleable visibility.
    </MudText>
    <MudText Typo="Typo.caption" Class="mb-3" Style="font-family: monospace;">
        &lt;LoadingBar Color="Color.Primary" Visible="true" /&gt;
    </MudText>
    <LoadingBar Color="Color.Primary" Visible="_loadingVisible" />
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="mt-3" OnClick="ToggleLoading">
        @(_loadingVisible ? "Hide" : "Show") Loading Bar
    </MudButton>
</MudPaper>

@* ===== FORM CARD ===== *@
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h5" Class="mb-2">FormCard</MudText>
    <MudText Typo="Typo.body2" Class="mb-3" Color="Color.Secondary">
        Card displaying a form summary with status badge, title, time elapsed, and action buttons.
    </MudText>
    <MudText Typo="Typo.caption" Class="mb-3" Style="font-family: monospace;">
        &lt;FormCard Status="Outbox" Title="Expense Claim" SubmittedBy="Smith, John" TimeElapsed="46 mins" Department="Finance" /&gt;
    </MudText>
</MudPaper>

<MudGrid>
    <MudItem xs="12" md="6">
        <FormCard Status="Outbox" Title="Hardware, Software and IT Services purchase form" SubmittedBy="Pieske, Benjamin" TimeElapsed="46 mins" Department="IT Services" />
    </MudItem>
    <MudItem xs="12" md="6">
        <FormCard Status="Outbox" Title="Microsoft CRM or Dynamics 365 Online Access" SubmittedBy="Wareing, Luke" TimeElapsed="4 hr 32 mins" Department="IT Services" />
    </MudItem>
    <MudItem xs="12" md="6">
        <FormCard Status="Inbox" Title="Expense Claim Request" SubmittedBy="Becerra, Egli" TimeElapsed="2 hr 15 mins" Department="Finance" />
    </MudItem>
    <MudItem xs="12" md="6">
        <FormCard Status="Outbox" Title="Hardware, Software and IT Services purchase form" SubmittedBy="Etsebeth, Jannes" TimeElapsed="6 hr 34 mins" Department="IT Services" />
    </MudItem>
    <MudItem xs="12" md="6">
        <FormCard Status="Complete" Title="Leave Request Application" SubmittedBy="Park, Lisa" TimeElapsed="3 days" Department="HR" />
    </MudItem>
    <MudItem xs="12" md="6">
        <FormCard Status="Outbox" Title="Australian Mobile Phone Form" SubmittedBy="Passlow, Daniel" TimeElapsed="2 days" Department="IT Services" />
    </MudItem>
    <MudItem xs="12" md="6">
        <FormCard Status="Inbox" Title="Purchase Order Approval" SubmittedBy="Chen, Mike" TimeElapsed="1 hr 10 mins" Department="Procurement" />
    </MudItem>
    <MudItem xs="12" md="6">
        <FormCard Status="Complete" Title="Salary Sacrifice Device Purchase" SubmittedBy="Pochec, Luke" TimeElapsed="5 days" Department="Finance" />
    </MudItem>
</MudGrid>

<div class="mb-6"></div>

@* ===== WORKFLOW STEPPER BRANCHING ===== *@
<MudPaper Class="pa-4 mb-4 mt-6" Elevation="1">
    <MudText Typo="Typo.h5" Class="mb-2">WorkflowStepsView</MudText>
    <MudText Typo="Typo.body2" Class="mb-3" Color="Color.Secondary">
        Hybrid stepper with carousel navigation, branch point indicators, and linear/full map toggle.
    </MudText>
    <MudText Typo="Typo.caption" Class="mb-3" Style="font-family: monospace;">
        &lt;WorkflowStepsView Steps="steps" VisibleSteps="5" /&gt;
    </MudText>

    <MudText Typo="Typo.h6" Class="mb-2 mt-4">Long Workflow — Carousel Active (8 steps)</MudText>
    <WorkflowStepsView Steps="_longWorkflowSteps" VisibleSteps="5" />

    <MudText Typo="Typo.h6" Class="mb-2 mt-6">Short Workflow — No Scrolling Needed (5 steps)</MudText>
    <WorkflowStepsView Steps="_branchingExpenseSteps" VisibleSteps="5" />

    <MudText Typo="Typo.h6" Class="mb-2 mt-6">IT Access Request — Completed with Skipped Branch</MudText>
    <WorkflowStepsView Steps="_branchingITSteps" VisibleSteps="5" />
</MudPaper>

<MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-4">More custom components coming soon...</MudText>

