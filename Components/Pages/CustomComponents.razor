@page "/custom-components"

<PageTitle>Custom Components</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Custom Components</MudText>

@* ===== STATUS TABS ===== *@
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h5" Class="mb-2">StatusTabs</MudText>
    <MudText Typo="Typo.body2" Class="mb-3" Color="Color.Secondary">
        Segmented button bar for filtering forms by status. Reusable component.
    </MudText>
    <MudText Typo="Typo.caption" Class="mb-3" Style="font-family: monospace;">
        &lt;StatusTabs InboxCount="36" OutboxCount="714" CompleteCount="15555" ActiveTab="inbox" OnTabChanged="Handler" /&gt;
    </MudText>
    <MudText Typo="Typo.subtitle2" Class="mb-2 mt-2">Parameters</MudText>
    <MudSimpleTable Dense="true" Bordered="true" Class="mb-4" Style="max-width: 700px;">
        <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
        <tbody>
            <tr><td><code>InboxCount</code></td><td>int</td><td>0</td><td>Number shown on the Inbox tab</td></tr>
            <tr><td><code>OutboxCount</code></td><td>int</td><td>0</td><td>Number shown on the Outbox tab</td></tr>
            <tr><td><code>CompleteCount</code></td><td>int</td><td>0</td><td>Number shown on the Complete tab</td></tr>
            <tr><td><code>ActiveTab</code></td><td>string</td><td>"inbox"</td><td>Currently selected tab ("inbox", "outbox", "complete")</td></tr>
            <tr><td><code>OnTabChanged</code></td><td>EventCallback&lt;string&gt;</td><td>—</td><td>Fires when a tab is clicked, returns tab name</td></tr>
        </tbody>
    </MudSimpleTable>
    <StatusTabs InboxCount="36" OutboxCount="714" CompleteCount="15555" ActiveTab="inbox" OnTabChanged="OnDemoTabChanged" />
    <MudText Typo="Typo.body2" Class="mt-3">Selected tab: <strong>@_demoTab</strong></MudText>
</MudPaper>

@* ===== LOADING BAR ===== *@
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h5" Class="mb-2">LoadingBar</MudText>
    <MudText Typo="Typo.body2" Class="mb-3" Color="Color.Secondary">
        Animated indeterminate progress bar for loading states. Toggleable visibility.
    </MudText>
    <MudText Typo="Typo.caption" Class="mb-3" Style="font-family: monospace;">
        &lt;LoadingBar Color="Color.Primary" Visible="true" /&gt;
    </MudText>
    <MudText Typo="Typo.subtitle2" Class="mb-2 mt-2">Parameters</MudText>
    <MudSimpleTable Dense="true" Bordered="true" Class="mb-4" Style="max-width: 700px;">
        <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
        <tbody>
            <tr><td><code>Color</code></td><td>Color</td><td>Color.Success</td><td>Bar colour (MudBlazor Color enum)</td></tr>
            <tr><td><code>Visible</code></td><td>bool</td><td>true</td><td>Show or hide the loading bar</td></tr>
            <tr><td><code>CssClass</code></td><td>string</td><td>""</td><td>Additional CSS classes</td></tr>
        </tbody>
    </MudSimpleTable>
    <LoadingBar Color="Color.Primary" Visible="_loadingVisible" />
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="mt-3" OnClick="ToggleLoading">
        @(_loadingVisible ? "Hide" : "Show") Loading Bar
    </MudButton>
</MudPaper>

@* ===== FORM CARD ===== *@
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h5" Class="mb-2">FormCard</MudText>
    <MudText Typo="Typo.body2" Class="mb-3" Color="Color.Secondary">
        Card displaying a form summary with status badge, title, time elapsed, and action buttons.
    </MudText>
    <MudText Typo="Typo.caption" Class="mb-3" Style="font-family: monospace;">
        &lt;FormCard Status="Outbox" Title="Expense Claim" SubmittedBy="Smith, John" TimeElapsed="46 mins" Department="Finance" /&gt;
    </MudText>
    <MudText Typo="Typo.subtitle2" Class="mb-2 mt-2">Parameters</MudText>
    <MudSimpleTable Dense="true" Bordered="true" Class="mb-4" Style="max-width: 700px;">
        <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
        <tbody>
            <tr><td><code>Status</code></td><td>string</td><td>"Inbox"</td><td>Badge label &amp; colour ("Inbox", "Outbox", "Complete")</td></tr>
            <tr><td><code>Title</code></td><td>string</td><td>""</td><td>Form title displayed on the card</td></tr>
            <tr><td><code>SubmittedBy</code></td><td>string</td><td>""</td><td>Name of the person who submitted</td></tr>
            <tr><td><code>TimeElapsed</code></td><td>string</td><td>""</td><td>Time since submission (e.g. "46 mins")</td></tr>
            <tr><td><code>Department</code></td><td>string</td><td>""</td><td>Department label shown top-right</td></tr>
            <tr><td><code>OnRedirect</code></td><td>EventCallback</td><td>—</td><td>Fires when Redirect button clicked</td></tr>
            <tr><td><code>OnView</code></td><td>EventCallback</td><td>—</td><td>Fires when View button clicked</td></tr>
        </tbody>
    </MudSimpleTable>
</MudPaper>

<MudGrid>
