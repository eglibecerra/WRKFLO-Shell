@page "/formosa"
@layout FormosaLayout
@rendermode InteractiveServer
@using System.Text.Json

<PageTitle>@_formName — Formosa</PageTitle>

<div class="fd-shell">

    @* ── TOP BAR ── *@
    <div class="fd-topbar">
        <div class="fd-topbar-left">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" Color="Color.Default" />
            <span class="fd-form-name">@_formName</span>
            <span class="fd-draft-badge">
                <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Style="font-size:8px; color:#3B82F6;" Class="mr-1" />
                Draft · @(_isDirty ? "Unsaved" : "Saved")
            </span>
        </div>
        <div class="fd-topbar-right">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Save" OnClick="SaveForm">Save</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Spellcheck">Check content</MudButton>
        </div>
    </div>

    @* ── TAB BAR ── *@
    <div class="fd-tabbar">
        <div class="fd-tabs">
            <button class="fd-tab @(_activeTab == "design" ? "fd-tab-active" : "")"
                    @onclick='() => _activeTab = "design"'>Design</button>
            <button class="fd-tab @(_activeTab == "preview" ? "fd-tab-active" : "")"
                    @onclick='() => _activeTab = "preview"'>Preview and test</button>
        </div>
        <div class="fd-toolbar">
            <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small" Disabled="true" />
            <MudIconButton Icon="@Icons.Material.Filled.Redo" Size="Size.Small" Disabled="true" />
            <MudDivider Vertical="true" FlexItem="true" Class="mx-1" Style="height:20px;align-self:center;" />
            <MudButton Variant="Variant.Text" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Code"
                       OnClick="() => _showJson = !_showJson">HTML</MudButton>
        </div>
    </div>

    @* ── MAIN AREA ── *@
    <div class="fd-main">

        @if (_activeTab == "design")
        {
            @* ── CANVAS ── *@
            <div class="fd-canvas"
                 @ondrop="OnCanvasDrop"
                 @ondrop:preventDefault="true"
                 @ondragover:preventDefault="true">

                @if (!_schema.Sections.Any())
                {
                    <div class="fd-canvas-empty">
                        <MudIcon Icon="@Icons.Material.Outlined.Dashboard" Size="Size.Large" Color="Color.Tertiary" />
                        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-2">
                            Select a layout section from the panel on the right
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Tertiary">
                            Then drag form elements into each column
                        </MudText>
                    </div>
                }
                else
                {
                    <div class="fd-sections">
                        @foreach (var formSection in _schema.Sections)
                        {
                            var def = GetLayout(formSection.LayoutType);
                            <div class="fd-section @(_selectedSectionId == formSection.Id ? "fd-section-selected" : "")"
                                 @onclick="() => SelectSection(formSection.Id)">

                                @* Section pill *@
                                <div class="fd-section-pill">
                                    <MudIcon Icon="@Icons.Material.Outlined.TableChart" Size="Size.Small" Class="mr-1" />
                                    <span>@def.Label</span>
                                    <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" Class="ml-1" />
                                    <div class="fd-pill-spacer"></div>
                                    <div @onclick:stopPropagation="true">
                                        <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                                       Size="Size.Small" Color="Color.Error"
                                                       OnClick="() => RemoveSection(formSection.Id)" />
                                    </div>
                                </div>

                                @* Column grid *@
                                <div class="fd-section-columns" style="grid-template-columns: @def.GridTemplate;">
                                    @foreach (var cell in formSection.Rows.First().Cells.OrderBy(c => c.ColumnIndex))
                                    {
                                        var sId = formSection.Id;
                                        var cId = cell.Id;
                                        <div class="fd-cell @(cell.Elements.Any() ? "fd-cell-has-elements" : "")"
                                             @ondragover:preventDefault="true"
                                             @ondrop:preventDefault="true"
                                             @ondrop="() => OnCellDrop(sId, cId)">

                                            @if (cell.Elements.Any())
                                            {
                                                @* Render elements *@
                                                <div class="fd-cell-elements">
                                                    @foreach (var el in cell.Elements)
                                                    {
                                                        <div class="fd-element">
                                                            @if (el.Type == "label")
                                                            {
                                                                <span class="fd-el-label-display">
                                                                    @el.Props.GetValueOrDefault("text", "Label")
                                                                </span>
                                                            }
                                                            else if (el.Type == "input-text")
                                                            {
                                                                <div class="fd-el-field">
                                                                    <label class="fd-el-label-text">@el.Props.GetValueOrDefault("label", "Text Field")</label>
                                                                    <input type="text" class="fd-el-input"
                                                                           placeholder="@el.Props.GetValueOrDefault("placeholder", "Enter text...")"
                                                                           disabled />
                                                                </div>
                                                            }
                                                            else if (el.Type == "input-number")
                                                            {
                                                                <div class="fd-el-field">
                                                                    <label class="fd-el-label-text">@el.Props.GetValueOrDefault("label", "Number")</label>
                                                                    <input type="number" class="fd-el-input" placeholder="0" disabled />
                                                                </div>
                                                            }
                                                            else if (el.Type == "input-date")
                                                            {
                                                                <div class="fd-el-field">
                                                                    <label class="fd-el-label-text">@el.Props.GetValueOrDefault("label", "Date")</label>
                                                                    <input type="date" class="fd-el-input" disabled />
                                                                </div>
                                                            }
                                                            else if (el.Type == "input-checkbox")
                                                            {
                                                                <div class="fd-el-checkbox">
                                                                    <input type="checkbox" disabled />
                                                                    <label class="fd-el-label-text">@el.Props.GetValueOrDefault("label", "Checkbox")</label>
                                                                </div>
                                                            }
                                                            else if (el.Type == "input-dropdown")
                                                            {
                                                                <div class="fd-el-field">
                                                                    <label class="fd-el-label-text">@el.Props.GetValueOrDefault("label", "Dropdown")</label>
                                                                    <select class="fd-el-input" disabled>
                                                                        <option>Select an option...</option>
                                                                    </select>
                                                                </div>
                                                            }
                                                            else if (el.Type == "input-textarea")
                                                            {
                                                                <div class="fd-el-field">
                                                                    <label class="fd-el-label-text">@el.Props.GetValueOrDefault("label", "Text Area")</label>
                                                                    <textarea class="fd-el-input fd-el-textarea"
                                                                              placeholder="@el.Props.GetValueOrDefault("placeholder", "Enter text...")"
                                                                              rows="3" disabled></textarea>
                                                                </div>
                                                            }
                                                            @* Remove element button *@
                                                            <div @onclick:stopPropagation="true" class="fd-element-remove">
                                                                <MudIconButton Icon="@Icons.Material.Outlined.Close"
                                                                               Size="Size.Small" Color="Color.Error"
                                                                               OnClick="() => RemoveElement(sId, cId, el.Id)" />
                                                            </div>
                                                        </div>
                                                    }
                                                    @* Drop more zone *@
                                                    <div class="fd-cell-drop-more">
                                                        <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Tertiary" />
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="fd-cell-placeholder">
                                                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Tertiary" />
                                                    <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mt-1">
                                                        Add element here
                                                    </MudText>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                @* JSON drawer *@
                @if (_showJson)
                {
                    <div class="fd-json-drawer">
                        <div class="fd-json-header">
                            <MudText Typo="Typo.subtitle2" Style="color:#cdd6f4;">Schema JSON</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                           Style="color:#585b70" OnClick="() => _showJson = false" />
                        </div>
                        <pre class="fd-json-output">@_schemaJson</pre>
                    </div>
                }
            </div>

            @* ── RIGHT SIDEBAR ── *@
            <div class="fd-sidebar">

                @* Layout section types *@
                <div class="fd-sidebar-section">
                    <div class="fd-sidebar-heading">
                        <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" Class="mr-1" />
                        <span>Layout section types</span>
                    </div>
                    <div class="fd-layout-grid">
                        @foreach (var opt in _layouts)
                        {
                            <div class="fd-layout-item"
                                 draggable="true"
                                 @ondragstart="() => OnLayoutDragStart(opt.Id)"
                                 @onclick="() => AddSection(opt.Id)">
                                <div class="fd-layout-thumb" style="grid-template-columns: @opt.GridTemplate;">
                                    @for (int i = 0; i < opt.ColumnCount; i++)
                                    {
                                        <div class="fd-layout-thumb-col"></div>
                                    }
                                </div>
                                <span class="fd-layout-label">@opt.Label</span>
                            </div>
                        }
                    </div>
                </div>

                <MudDivider Class="my-3" />

                @* Form elements *@
                <div class="fd-sidebar-section">
                    <div class="fd-sidebar-heading">
                        <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" Class="mr-1" />
                        <span>Form elements</span>
                    </div>
                    <div class="fd-element-list">
                        @foreach (var elDef in _elementDefs)
                        {
                            <div class="fd-element-item"
                                 draggable="true"
                                 @ondragstart="() => OnElementDragStart(elDef.Type)">
                                <MudIcon Icon="@elDef.Icon" Size="Size.Small" Color="Color.Primary" Class="mr-2" />
                                <span>@elDef.Label</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            @* ── PREVIEW TAB ── *@
            <div class="fd-preview">
                <MudText Typo="Typo.h6" Class="mb-6">@_formName</MudText>
                @if (!_schema.Sections.Any())
                {
                    <MudText Color="Color.Secondary">No sections added yet.</MudText>
                }
                else
                {
                    @foreach (var formSection in _schema.Sections)
                    {
                        var def = GetLayout(formSection.LayoutType);
                        <div class="fd-preview-section" style="grid-template-columns: @def.GridTemplate;">
                            @foreach (var cell in formSection.Rows.First().Cells.OrderBy(c => c.ColumnIndex))
                            {
                                <div class="fd-preview-cell">
                                    @foreach (var el in cell.Elements)
                                    {
                                        <div class="fd-preview-element">
                                            @if (el.Type == "label")
                                            {
                                                <p class="fd-preview-label">@el.Props.GetValueOrDefault("text", "Label")</p>
                                            }
                                            else if (el.Type == "input-text")
                                            {
                                                <div class="fd-preview-field">
                                                    <label>@el.Props.GetValueOrDefault("label", "Text Field")</label>
                                                    <input type="text" placeholder="@el.Props.GetValueOrDefault("placeholder", "")" class="fd-preview-input" />
                                                </div>
                                            }
                                            else if (el.Type == "input-number")
                                            {
                                                <div class="fd-preview-field">
                                                    <label>@el.Props.GetValueOrDefault("label", "Number")</label>
                                                    <input type="number" placeholder="0" class="fd-preview-input" />
                                                </div>
                                            }
                                            else if (el.Type == "input-date")
                                            {
                                                <div class="fd-preview-field">
                                                    <label>@el.Props.GetValueOrDefault("label", "Date")</label>
                                                    <input type="date" class="fd-preview-input" />
                                                </div>
                                            }
                                            else if (el.Type == "input-checkbox")
                                            {
                                                <div class="fd-preview-checkbox">
                                                    <input type="checkbox" id="@el.Id" />
                                                    <label for="@el.Id">@el.Props.GetValueOrDefault("label", "Checkbox")</label>
                                                </div>
                                            }
                                            else if (el.Type == "input-dropdown")
                                            {
                                                <div class="fd-preview-field">
                                                    <label>@el.Props.GetValueOrDefault("label", "Dropdown")</label>
                                                    <select class="fd-preview-input">
                                                        <option>Select an option...</option>
                                                    </select>
                                                </div>
                                            }
                                            else if (el.Type == "input-textarea")
                                            {
                                                <div class="fd-preview-field">
                                                    <label>@el.Props.GetValueOrDefault("label", "Text Area")</label>
                                                    <textarea placeholder="@el.Props.GetValueOrDefault("placeholder", "")"
                                                              rows="3" class="fd-preview-input fd-preview-textarea"></textarea>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
    </div>
</div>

@code {
    // ── State ──
    private FormSchema _schema = new();
    private string _formName = "Form 1";
    private string _activeTab = "design";
    private string? _selectedSectionId;
    private string _draggingLayoutId = "";
    private string _draggingElementType = "";
    private bool _isDirty = false;
    private bool _showJson = false;
    private string _schemaJson = "";

    // ── Layout definitions ──
    private readonly List<FormLayoutDefinition> _layouts = new()
    {
        new() { Id = "1-col",   Label = "1 column",   ColumnCount = 1, GridTemplate = "1fr" },
        new() { Id = "1-2-col", Label = "1:2 column", ColumnCount = 2, GridTemplate = "1fr 2fr" },
        new() { Id = "2-col",   Label = "2 column",   ColumnCount = 2, GridTemplate = "1fr 1fr" },
        new() { Id = "2-1-col", Label = "2:1 column", ColumnCount = 2, GridTemplate = "2fr 1fr" },
        new() { Id = "3-col",   Label = "3 column",   ColumnCount = 3, GridTemplate = "1fr 1fr 1fr" },
        new() { Id = "custom",  Label = "Custom",     ColumnCount = 3, GridTemplate = "1fr 1fr 1fr" },
    };

    // ── Element definitions (UI only) ──
    private record ElementDef(string Type, string Label, string Icon);

    private readonly List<ElementDef> _elementDefs = new()
    {
        new("label",          "Label",     Icons.Material.Filled.TextFields),
        new("input-text",     "Text",      Icons.Material.Outlined.ShortText),
        new("input-number",   "Number",    Icons.Material.Outlined.Numbers),
        new("input-date",     "Date",      Icons.Material.Outlined.DateRange),
        new("input-checkbox", "Checkbox",  Icons.Material.Outlined.CheckBox),
        new("input-dropdown", "Dropdown",  Icons.Material.Outlined.ArrowDropDownCircle),
        new("input-textarea", "Text Area", Icons.Material.Outlined.Notes),
    };

    protected override void OnInitialized() => UpdateJson();

    // ── Layout helpers ──
    private FormLayoutDefinition GetLayout(string id) =>
        _layouts.FirstOrDefault(l => l.Id == id) ?? _layouts[0];

    // ── Drag: layout sections ──
    private void OnLayoutDragStart(string layoutId)
    {
        _draggingLayoutId = layoutId;
        _draggingElementType = "";
    }

    private void OnCanvasDrop()
    {
        if (!string.IsNullOrEmpty(_draggingLayoutId))
        {
            AddSection(_draggingLayoutId);
            _draggingLayoutId = "";
        }
    }

    // ── Drag: elements ──
    private void OnElementDragStart(string elementType)
    {
        _draggingElementType = elementType;
        _draggingLayoutId = "";
    }

    private void OnCellDrop(string sectionId, string cellId)
    {
        if (string.IsNullOrEmpty(_draggingElementType)) return;

        var cell = _schema.Sections
            .FirstOrDefault(s => s.Id == sectionId)
            ?.Rows.SelectMany(r => r.Cells)
            .FirstOrDefault(c => c.Id == cellId);

        if (cell == null) return;

        cell.Elements.Add(new FormElement
        {
            Type = _draggingElementType,
            Props = GetDefaultProps(_draggingElementType)
        });

        _draggingElementType = "";
        _schema.UpdatedAt = DateTime.UtcNow;
        _isDirty = true;
        UpdateJson();
    }

    private Dictionary<string, string> GetDefaultProps(string type) => type switch
    {
        "label"          => new() { ["text"] = "Label" },
        "input-text"     => new() { ["label"] = "Text Field",  ["placeholder"] = "Enter text...",  ["required"] = "false" },
        "input-number"   => new() { ["label"] = "Number",      ["placeholder"] = "0",              ["required"] = "false" },
        "input-date"     => new() { ["label"] = "Date",                                             ["required"] = "false" },
        "input-checkbox" => new() { ["label"] = "Checkbox",                                         ["required"] = "false" },
        "input-dropdown" => new() { ["label"] = "Dropdown",    ["options"] = "Option 1,Option 2,Option 3", ["required"] = "false" },
        "input-textarea" => new() { ["label"] = "Text Area",   ["placeholder"] = "Enter text...",  ["required"] = "false", ["rows"] = "3" },
        _                => new()
    };

    // ── Section actions ──
    private void AddSection(string layoutId)
    {
        var def = GetLayout(layoutId);
        var formSection = new FormSection
        {
            Label = $"Section {_schema.Sections.Count + 1}",
            LayoutType = layoutId,
            Columns = def.ColumnCount,
            Rows = new List<FormRow>
            {
                new FormRow
                {
                    Cells = Enumerable.Range(0, def.ColumnCount)
                        .Select(i => new FormCell { ColumnIndex = i })
                        .ToList()
                }
            }
        };
        _schema.Sections.Add(formSection);
        _schema.UpdatedAt = DateTime.UtcNow;
        _selectedSectionId = formSection.Id;
        _isDirty = true;
        UpdateJson();
    }

    private void RemoveSection(string id)
    {
        _schema.Sections.RemoveAll(s => s.Id == id);
        if (_selectedSectionId == id) _selectedSectionId = null;
        _schema.UpdatedAt = DateTime.UtcNow;
        _isDirty = true;
        UpdateJson();
    }

    private void RemoveElement(string sectionId, string cellId, string elementId)
    {
        var cell = _schema.Sections
            .FirstOrDefault(s => s.Id == sectionId)
            ?.Rows.SelectMany(r => r.Cells)
            .FirstOrDefault(c => c.Id == cellId);

        cell?.Elements.RemoveAll(e => e.Id == elementId);
        _schema.UpdatedAt = DateTime.UtcNow;
        _isDirty = true;
        UpdateJson();
    }

    private void SelectSection(string id) =>
        _selectedSectionId = _selectedSectionId == id ? null : id;

    private void SaveForm() => _isDirty = false;

    private void UpdateJson() =>
        _schemaJson = JsonSerializer.Serialize(_schema, new JsonSerializerOptions { WriteIndented = true });
}
