@inherits LayoutComponentBase
@inject IStringLocalizer<MainLayout> L

<ThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @* HEADER *@
    <MudAppBar Elevation="3" Class="wrkflo-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Class="wrkflo-menu-btn" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <AppLogo />
        <MudSpacer />
        <NavSearch Placeholder="@L["SearchForms"]" OnSearch="OnSearchForms" Results="_searchResults" OnResultSelected="OnSearchResultSelected" />
        <MudSpacer />
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <ActivatorContent>
                <MudButton Variant="Variant.Text" Class="wrkflo-user-btn">
                    <MudText Typo="Typo.body2" Class="mr-2 wrkflo-user-name">Becerra, Egli</MudText>
                    <MudAvatar Size="Size.Small" Class="wrkflo-user-avatar">
                        <MudImage Src="images/avatar-egli.png" Alt="Egli Becerra" />
                    </MudAvatar>
                </MudButton>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Icon="@Icons.Material.Filled.Notifications" IconColor="Color.Primary">
                    @L["Notifications"]
                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Class="ml-2">3</MudChip>
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Email" IconColor="Color.Primary">@L["Messages"]</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Settings" IconColor="Color.Primary">@L["Settings"]</MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.Person" IconColor="Color.Primary">@L["MyProfile"]</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.ExitToApp" IconColor="Color.Error">@L["SignOut"]</MudMenuItem>
            </ChildContent>
        </MudMenu>
    </MudAppBar>

    @* LEFT NAVIGATION *@
    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always">
        <MudNavMenu>
            <MudNavLink Href="/" Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Primary" Class="wrkflo-nav-link">@L["Dashboard"]</MudNavLink>
            <MudNavLink Href="/forms" Icon="@Icons.Material.Filled.Description" IconColor="Color.Primary" Class="wrkflo-nav-link">@L["Forms"]</MudNavLink>
            <MudNavLink Href="/workflows" Icon="@Icons.Material.Filled.AccountTree" IconColor="Color.Primary" Class="wrkflo-nav-link">@L["Workflows"]</MudNavLink>
            <MudNavGroup Title="@L["Admin"]" Icon="@Icons.Material.Filled.AdminPanelSettings" IconColor="Color.Primary" Class="wrkflo-nav-link" Expanded="false">
                <MudNavLink Href="/admin/users" Icon="@Icons.Material.Filled.People" IconColor="Color.Primary" Class="wrkflo-nav-link">@L["Users"]</MudNavLink>
                <MudNavGroup Title="@L["Settings"]" Icon="@Icons.Material.Filled.Settings" IconColor="Color.Primary" Class="wrkflo-nav-link" Expanded="false">
                    <MudNavLink Href="/admin/settings/general" Icon="@Icons.Material.Filled.Tune" IconColor="Color.Primary" Class="wrkflo-nav-link">@L["General"]</MudNavLink>
                    <MudNavLink Href="/admin/settings/notifications" Icon="@Icons.Material.Filled.Notifications" IconColor="Color.Primary" Class="wrkflo-nav-link">@L["Notifications"]</MudNavLink>
                    <MudNavLink Href="/admin/settings/security" Icon="@Icons.Material.Filled.Security" IconColor="Color.Primary" Class="wrkflo-nav-link">@L["Security"]</MudNavLink>
                </MudNavGroup>
                <MudNavLink Href="/admin/branding" Icon="@Icons.Material.Filled.Palette" IconColor="Color.Primary" Class="wrkflo-nav-link">@L["Branding"]</MudNavLink>
            </MudNavGroup>
            <MudDivider Class="my-2" />
            <MudNavLink Href="/login" Icon="@Icons.Material.Filled.Login" IconColor="Color.Primary" Class="wrkflo-nav-link">Login</MudNavLink>
            <MudDivider Class="my-2" />
            <MudNavLink Href="/components" Icon="@Icons.Material.Filled.Widgets" IconColor="Color.Primary" Class="wrkflo-nav-link">@L["ComponentShowcase"]</MudNavLink>
            <MudNavLink Href="/custom-components" Icon="@Icons.Material.Filled.Extension" IconColor="Color.Primary" Class="wrkflo-nav-link">@L["CustomComponents"]</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    @* MAIN CONTENT *@
    <MudMainContent>
        @* ANNOUNCEMENT BAR — full width, outside container *@
        <AnnouncementBar @bind-Visible="_announcementVisible"
                         Severity="Severity.Info"
                         Message="🚀 WRKFLO v2.0 is coming soon! New form builder, workflow engine, and more."
                         ActionText="Learn more"
                         ActionHref="/changelog"
                         Dismissible="true" />
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-4 pb-16">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@* FOOTER *@
<footer class="wrkflo-footer-wrapper">
    <LoadingBar Color="Color.Primary" Visible="_isLoading" CssClass="wrkflo-footer-loader" />
    <div class="wrkflo-footer">
        <MudText Typo="Typo.body2" Class="wrkflo-footer-text">@L["FooterText"]</MudText>
        <MudSpacer />
        <PoweredBy />
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="wrkflo-footer-text">v0.1.0</MudText>
    </div>
</footer>

@code {
    private bool _drawerOpen = false;
    private bool _isLoading = true; // Demo: shows loading bar
    private bool _announcementVisible = true;
    private List<NavSearch.SearchResult> _searchResults = [];

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void OnSearchForms(string query)
    {
        // TODO: Replace with API call to search forms/workflows
        // Demo: static results for now
        var allForms = new List<NavSearch.SearchResult>
        {
            new() { Title = "Leave Request", Subtitle = "HR", Icon = Icons.Material.Filled.EventBusy, Href = "/forms/1", Category = "Form" },
            new() { Title = "Expense Claim", Subtitle = "Finance", Icon = Icons.Material.Filled.Receipt, Href = "/forms/2", Category = "Form" },
            new() { Title = "Hardware Request", Subtitle = "IT Services", Icon = Icons.Material.Filled.Computer, Href = "/forms/3", Category = "Form" },
            new() { Title = "Purchase Order", Subtitle = "Procurement", Icon = Icons.Material.Filled.ShoppingCart, Href = "/forms/4", Category = "Form" },
            new() { Title = "IT Access Request", Subtitle = "IT Services", Icon = Icons.Material.Filled.VpnKey, Href = "/forms/5", Category = "Form" },
        };

        _searchResults = allForms
            .Where(f => f.Title.Contains(query, StringComparison.OrdinalIgnoreCase)
                     || (f.Subtitle?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();
    }

    private void OnSearchResultSelected(NavSearch.SearchResult result)
    {
        // TODO: Navigate to the selected form/workflow
        if (!string.IsNullOrEmpty(result.Href))
        {
            // NavigationManager.NavigateTo(result.Href);
        }
    }

}
