@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @* HEADER *@
    <MudAppBar Elevation="3" Style="background-color: #F9FAFB; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Style="color: #4F46E5;" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Style="font-weight: 600; color: #4F46E5;">WrkFlo</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="_searchText" Placeholder="Search Forms" Variant="Variant.Outlined" Margin="Margin.Dense"
            Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" AdornmentColor="Color.Primary"
            Style="max-width: 650px; width: 100%; background: white; border-radius: 8px;" />
        <MudSpacer />
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <ActivatorContent>
                <MudButton Variant="Variant.Text" Style="text-transform: none; color: #111827;">
                    <MudText Typo="Typo.body2" Class="mr-2" Style="color: #6B7280;">Becerra, Egli</MudText>
                    <MudAvatar Size="Size.Small" Style="width: 36px; height: 36px;">
                        <MudImage Src="images/avatar-egli.png" Alt="Egli Becerra" />
                    </MudAvatar>
                </MudButton>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Icon="@Icons.Material.Filled.Notifications" IconColor="Color.Primary">
                    Notifications
                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Class="ml-2">3</MudChip>
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Email" IconColor="Color.Primary">Messages</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Settings" IconColor="Color.Primary">Settings</MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.Person" IconColor="Color.Primary">My Profile</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.ExitToApp" IconColor="Color.Error">Sign Out</MudMenuItem>
            </ChildContent>
        </MudMenu>
    </MudAppBar>

    @* LEFT NAVIGATION *@
    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always">
        <MudNavMenu Class="pt-0" Style="margin-top: 0;">
            <MudNavLink Href="/" Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Primary" Style="color: #4F46E5;">Dashboard</MudNavLink>
            <MudNavLink Href="/forms" Icon="@Icons.Material.Filled.Description" IconColor="Color.Primary" Style="color: #4F46E5;">Forms</MudNavLink>
            <MudNavLink Href="/workflows" Icon="@Icons.Material.Filled.AccountTree" IconColor="Color.Primary" Style="color: #4F46E5;">Workflows</MudNavLink>
            <MudDivider Class="my-2" />
            <MudNavLink Href="/components" Icon="@Icons.Material.Filled.Widgets" IconColor="Color.Primary" Style="color: #4F46E5;">Component Showcase</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    @* MAIN CONTENT *@
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-4 pb-16">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@* FOOTER *@
<MudAppBar Bottom="true" Elevation="0" Style="background-color: #F9FAFB; border-top: 1px solid #E5E7EB; min-height: 40px; height: 40px;">
    <MudText Typo="Typo.body2" Style="color: #4F46E5;">WrkFlo © 2026 by { bectec }</MudText>
    <MudSpacer />
    <MudText Typo="Typo.body2" Style="color: #4F46E5;">v0.1.0</MudText>
</MudAppBar>

@code {
    private bool _drawerOpen = false;
    private string _searchText = "";

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private readonly MudTheme _theme = new()
    {
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = new[] { "Roboto", "Helvetica", "Arial", "sans-serif" }
            }
        },
        PaletteLight = new PaletteLight
        {
            Primary = "#4F46E5",
            Secondary = "#818CF8",
            Background = "#F9FAFB",
            Surface = "#FFFFFF",
            AppbarBackground = "#F9FAFB",
            AppbarText = "#4F46E5",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#111827"
        }
    };
}
