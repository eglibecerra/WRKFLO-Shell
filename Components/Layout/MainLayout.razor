@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @* HEADER *@
    <MudAppBar Elevation="3" Class="wrkflo-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Class="wrkflo-menu-btn" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="wrkflo-logo">WrkFlo</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="_searchText" Placeholder="Search Forms" Variant="Variant.Outlined" Margin="Margin.Dense"
            Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" AdornmentColor="Color.Primary"
            Class="wrkflo-search" />
        <MudSpacer />
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <ActivatorContent>
                <MudButton Variant="Variant.Text" Class="wrkflo-user-btn">
                    <MudText Typo="Typo.body2" Class="mr-2 wrkflo-user-name">Becerra, Egli</MudText>
                    <MudAvatar Size="Size.Small" Class="wrkflo-user-avatar">
                        <MudImage Src="images/avatar-egli.png" Alt="Egli Becerra" />
                    </MudAvatar>
                </MudButton>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Icon="@Icons.Material.Filled.Notifications" IconColor="Color.Primary">
                    Notifications
                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Class="ml-2">3</MudChip>
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Email" IconColor="Color.Primary">Messages</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Settings" IconColor="Color.Primary">Settings</MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.Person" IconColor="Color.Primary">My Profile</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.ExitToApp" IconColor="Color.Error">Sign Out</MudMenuItem>
            </ChildContent>
        </MudMenu>
    </MudAppBar>

    @* LEFT NAVIGATION *@
    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always">
        <MudNavMenu>
            <MudNavLink Href="/" Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Primary" Class="wrkflo-nav-link">Dashboard</MudNavLink>
            <MudNavLink Href="/forms" Icon="@Icons.Material.Filled.Description" IconColor="Color.Primary" Class="wrkflo-nav-link">Forms</MudNavLink>
            <MudNavLink Href="/workflows" Icon="@Icons.Material.Filled.AccountTree" IconColor="Color.Primary" Class="wrkflo-nav-link">Workflows</MudNavLink>
            <MudDivider Class="my-2" />
            <MudNavLink Href="/components" Icon="@Icons.Material.Filled.Widgets" IconColor="Color.Primary" Class="wrkflo-nav-link">Component Showcase</MudNavLink>
            <MudNavLink Href="/custom-components" Icon="@Icons.Material.Filled.Extension" IconColor="Color.Primary" Class="wrkflo-nav-link">Custom Components</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    @* MAIN CONTENT *@
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-4 pb-16">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@* FOOTER *@
<footer class="wrkflo-footer-wrapper">
    <LoadingBar Color="Color.Primary" Visible="_isLoading" CssClass="wrkflo-footer-loader" />
    <div class="wrkflo-footer">
        <MudText Typo="Typo.body2" Class="wrkflo-footer-text">WrkFlo © 2026 by { bectec }</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="wrkflo-footer-text">v0.1.0</MudText>
    </div>
</footer>

@code {
    private bool _drawerOpen = false;
    private string _searchText = "";
    private bool _isLoading = true; // Demo: shows loading bar

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private readonly MudTheme _theme = new()
    {
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = new[] { "Roboto", "Helvetica", "Arial", "sans-serif" }
            }
        },
        PaletteLight = new PaletteLight
        {
            Primary = "#4F46E5",
            Secondary = "#818CF8",
            Background = "#F9FAFB",
            Surface = "#FFFFFF",
            AppbarBackground = "#F9FAFB",
            AppbarText = "#4F46E5",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#111827"
        }
    };
}
