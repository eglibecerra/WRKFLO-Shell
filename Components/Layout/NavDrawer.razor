@rendermode InteractiveServer

<MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />

<MudDrawer @bind-Open="_drawerOpen" Elevation="2" Variant="DrawerVariant.Temporary">
    <MudDrawerHeader>
        <MudText Typo="Typo.h6">Menu</MudText>
    </MudDrawerHeader>
    <MudNavMenu>
        <MudNavLink Href="/" Icon="@Icons.Material.Filled.Dashboard" OnClick="CloseDrawer">Dashboard</MudNavLink>
        <MudNavLink Href="/forms" Icon="@Icons.Material.Filled.Description" OnClick="CloseDrawer">Forms</MudNavLink>
        <MudNavLink Href="/workflows" Icon="@Icons.Material.Filled.AccountTree" OnClick="CloseDrawer">Workflows</MudNavLink>
    </MudNavMenu>
</MudDrawer>

@code {
    private bool _drawerOpen = false;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void CloseDrawer()
    {
        _drawerOpen = false;
    }
}
